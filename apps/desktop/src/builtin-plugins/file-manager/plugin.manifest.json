{
    "id": "com.sigil.file-manager",
    "version": "0.0.1",
    "permissions": ["state.write", "filesystem.read", "filesystem.write"],
    "emits": ["file-manager.completed"],
    "nodeType": "file-manager",
    "nodeContract": {
        "identity": {
            "namespace": "plugin",
            "pluginId": "com.sigil.file-manager",
            "type": "file-manager"
        },
        "version": 1,
        "role": "action",
        "configSchema": {
            "version": 1,
            "dialect": "https://json-schema.org/draft/2020-12/schema",
            "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                    "action": {
                        "type": "string",
                        "enum": ["move", "rename", "copy"]
                    },
                    "destination": {
                        "type": "string",
                        "minLength": 1
                    },
                    "onConflict": {
                        "type": "string",
                        "enum": ["skip", "overwrite", "auto-rename", "error"]
                    }
                },
                "required": ["action", "destination"],
                "additionalProperties": false
            }
        },
        "defaultConfig": {
            "action": "move",
            "destination": "/",
            "onConflict": "skip"
        },
        "outputPorts": {
            "kind": "fixed",
            "ports": [{ "id": "out", "label": "Output" }]
        },
        "display": {
            "label": "File Manager",
            "description": "Moves, renames, or copies the file carried by the incoming event.",
            "category": "system"
        }
    }
}
