{
    "id": "com.sigil.file-watcher",
    "version": "0.0.1",
    "permissions": ["state.write", "filesystem.read"],
    "emits": ["file.created", "file.modified", "file.deleted"],
    "nodeType": "file-watcher",
    "nodeContract": {
        "identity": {
            "namespace": "plugin",
            "pluginId": "com.sigil.file-watcher",
            "type": "file-watcher"
        },
        "version": 1,
        "role": "trigger",
        "configSchema": {
            "version": 1,
            "dialect": "https://json-schema.org/draft/2020-12/schema",
            "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                    "path": {
                        "type": "string",
                        "minLength": 1
                    },
                    "recursive": {
                        "type": "boolean"
                    },
                    "events": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                            "type": "string",
                            "enum": ["file.created", "file.modified", "file.deleted"]
                        }
                    },
                    "ignorePatterns": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "required": ["path", "recursive", "events"],
                "additionalProperties": false
            }
        },
        "defaultConfig": {
            "path": "/",
            "recursive": true,
            "events": ["file.created"]
        },
        "outputPorts": {
            "kind": "fixed",
            "ports": [{ "id": "out", "label": "Output" }]
        },
        "display": {
            "label": "File Watcher",
            "description": "Emits an event when files are created, modified, or deleted in a watched path.",
            "category": "trigger"
        }
    }
}
