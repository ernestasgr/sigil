{
    "name": "@sigil/workflow-domain",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Pure Workflow compilation, admission, and Node Contract domain behavior for Sigil.",
    "main": "./dist/workflow-domain.js",
    "types": "./dist/workflow-domain.d.ts",
    "exports": {
        ".": {
            "types": "./dist/workflow-domain.d.ts",
            "import": "./dist/workflow-domain.js",
            "default": "./dist/workflow-domain.js"
        },
        "./compilation": {
            "types": "./dist/compilation.d.ts",
            "import": "./dist/compilation.js",
            "default": "./dist/compilation.js"
        },
        "./topology": {
            "types": "./dist/topology.d.ts",
            "import": "./dist/topology.js",
            "default": "./dist/topology.js"
        },
        "./node-contract": {
            "types": "./dist/node-contract.d.ts",
            "import": "./dist/node-contract.js",
            "default": "./dist/node-contract.js"
        },
        "./nodes/catalog": {
            "types": "./dist/nodes/catalog.d.ts",
            "import": "./dist/nodes/catalog.js",
            "default": "./dist/nodes/catalog.js"
        },
        "./nodes/switch": {
            "types": "./dist/nodes/switch.d.ts",
            "import": "./dist/nodes/switch.js",
            "default": "./dist/nodes/switch.js"
        },
        "./nodes/types": {
            "types": "./dist/nodes/types.d.ts",
            "import": "./dist/nodes/types.js",
            "default": "./dist/nodes/types.js"
        },
        "./samples": {
            "types": "./dist/samples.d.ts",
            "import": "./dist/samples.js",
            "default": "./dist/samples.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@sigil/contracts": "workspace:*",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@types/node": "26.1.1",
        "@vitest/coverage-v8": "4.1.10",
        "fast-check": "3.23.2",
        "typescript": "^6.0.3",
        "vite": "7.3.5",
        "vitest": "4.1.10"
    }
}
