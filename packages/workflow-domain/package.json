{
    "name": "@sigil/workflow-domain",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Pure Workflow compilation, admission, and Node Contract domain behavior for Sigil.",
    "main": "./dist/workflow-domain.js",
    "types": "./dist/workflow-domain.d.ts",
    "exports": {
        ".": {
            "types": "./dist/workflow-domain.d.ts",
            "import": "./dist/workflow-domain.js",
            "default": "./dist/workflow-domain.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@sigil/contracts": "workspace:*",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@types/node": "26.1.1",
        "@vitest/coverage-v8": "4.1.10",
        "fast-check": "3.23.2",
        "typescript": "^6.0.3",
        "vite": "7.3.5",
        "vitest": "4.1.10"
    }
}
